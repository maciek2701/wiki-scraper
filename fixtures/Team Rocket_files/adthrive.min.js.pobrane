          color: #000;
          box-sizing: border-box;
        }

        :host *, :host *::before, :host *::after {
          all: revert;
          box-sizing: border-box;
        }

        div.container {
          user-select: none;
          padding: 16px;
          text-align: center;
          display: flex;
          flex-direction: column;
          justify-content: center;
          width: 100%;
          height: 100%;
          gap: 1em;
        }

        div.container.b {
          justify-content: space-between;
          border-left: 1px solid #000;
          text-align: left;
        }

        div.sponsor {
          width: 100%;
        }

        div.container h1 {
          margin: 0 0 0.5em 0;
          font-size: 0.75em;
          font-weight: 300;
        }

        div.container.a h1 { text-align: center; }
        div.container.b h1 { text-align: left; }

        div.container img {
          display: block;
          width: 100%;
          height: auto;
          margin: 0;
        }

        div.container a {
          font-size: 1em;
          color: #fff;
          background: #000;
          padding: 0.5em;
          display: block;
          text-align: center;
          font-weight: normal;
          text-decoration: none;
          line-height: 1.2;
        }
        div.container a:hover { opacity: 0.9; }
        div.container a:focus-visible { outline: auto; outline-offset: 0.125em; }

        div.container.is-mobile {
          padding: 8px;
        }

        div.container.b.is-mobile {
          border-left: none;
        }

        div.container.is-mobile h1 {
          font-size: .9em;
        }

        div.container.is-mobile a {
          font-size: 1.2em;
        }
